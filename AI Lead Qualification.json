        "messages": {
          "values": [
            {
              "content": "=You are an expert sales development representative. Analyze the following lead:\nMessage: {{ $json.body.message }}\nBudget: {{ $json.body.budget }}\n\nReturn ONLY a valid JSON object with the following keys, with no markdown fences (no ```json):\n{\n  \"score\": (integer 1-10),\n  \"category\": (string: \"hot\", \"warm\", or \"spam\"),\n  \"intent\": (string, 3 words max),\n  \"urgency\": (string: \"high\", \"medium\", \"low\"),\n  \"summary\": (string, 1 sentence summary),\n  \"suggested_reply\": (string, draft email response)\n}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        208,
        16
      ],
      "id": "f6e41742-e4d9-4381-b9b2-706a026add79",
      "name": "Gemini AI Lead Scoring",
      "credentials": {
        "googlePalmApi": {
          "id": "ZhI6VoIC7W2FT0rU",
          "name": "Google Gemini(PaLM) Api account 3"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// 1. If n8n already parsed it at the root level\nif (item.score !== undefined) {\n    return { json: item };\n}\n\nlet rawText = \"\";\n\n// 2. Safely drill down into the nested 'parts' structure shown in your output\nif (item.content && item.content.parts && item.content.parts.length > 0 && item.content.parts[0].text) {\n    rawText = item.content.parts[0].text;\n} \n// Fallback for simpler node outputs\nelse {\n    rawText = item.text || item.output || item.message || item.response || \"\";\n}\n\nif (!rawText) {\n    throw new Error(\"Could not extract text. Please check the input structure.\");\n}\n\n// 3. Strip out markdown formatting if Gemini included it\nlet cleanText = rawText.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\n// 4. Parse and return the clean JSON\nreturn { json: JSON.parse(cleanText) };"
      },
      "type": "n8n-nodes-base.code",
